generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  MERCHANT
  ADMIN
}

enum MerchantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum WalletType {
  EOA
  SMART
}

enum ChainNetwork {
  ARC_TESTNET
  ARC_MAINNET
  BASE_SEPOLIA
  BASE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  EXPIRED
  CANCELLED
}

enum TransactionType {
  PAYMENT
  REFUND
  DEPOSIT
  WITHDRAW
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum PaymentMethod {
  WALLET
  QR
  PAYMENT_LINK
  CHECKOUT
  API
}

enum PaymentIntentStatus {
  CREATED
  PENDING
  COMPLETED
  EXPIRED
  CANCELLED
}

enum PaymentLinkStatus {
  ACTIVE
  PAID
  EXPIRED
  CANCELLED
}

model User {
  id String @id @default(uuid())

  email String? @unique

  username String?

  avatar String?

  role UserRole @default(USER)

  merchants Merchant[]

  wallets Wallet[]

  sessions Session[]

  apiKeys ApiKey[]

  auditLogs AuditLog[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([email])
}

model Wallet {
  id String @id @default(uuid())

  address String @unique

  network ChainNetwork

  walletType WalletType

  userId String

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([address])
}

model Merchant {
  id String @id @default(uuid())

  ownerId String

  owner User @relation(fields: [ownerId], references: [id])

  name String

  slug String @unique

  logo String?

  description String?

  website String?

  supportEmail String?

  webhookUrl String?

  status MerchantStatus @default(PENDING)

  invoices Invoice[]

  payments Payment[]

  apiKeys ApiKey[]

  webhooks Webhook[]

  webhookEvents WebhookEvent[]

  paymentLinks PaymentLink[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  paymentIntents PaymentIntent[]
}

model PaymentIntent {
  id String @id @default(uuid())

  merchantId String

  merchant Merchant @relation(fields: [merchantId], references: [id])

  amount Decimal @db.Decimal(20, 6)

  currency String @default("USDC")

  method PaymentMethod

  status PaymentIntentStatus @default(CREATED)

  description String?

  reference String? @unique

  clientSecret String @unique

  checkoutUrl String?

  metadata Json?

  expiresAt DateTime?

  payments Payment[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([merchantId])
  @@index([reference])
}

model Invoice {
  id String @id @default(uuid())

  invoiceNumber String @unique

  merchantId String

  merchant Merchant @relation(fields: [merchantId], references: [id])

  amount Decimal @db.Decimal(20, 6)

  currency String @default("USDC")

  memo String?

  status InvoiceStatus @default(DRAFT)

  expiresAt DateTime?

  paidAt DateTime?

  payments Payment[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([invoiceNumber])
}

model Payment {
  id String @id @default(uuid())

  invoiceId String?

  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  merchantId String

  merchant Merchant @relation(fields: [merchantId], references: [id])

  paymentIntentId String?

  paymentIntent PaymentIntent? @relation(fields: [paymentIntentId], references: [id])

  payerAddress String?

  receiverAddress String?

  txHash String? @unique

  blockNumber BigInt?

  confirmations Int @default(0)

  network ChainNetwork

  tokenAddress String

  amount Decimal @db.Decimal(20, 6)

  currency String @default("USDC")

  method PaymentMethod

  status PaymentStatus @default(PENDING)

  reference String? @unique

  failureReason String?

  metadata Json?

  paidAt DateTime?

  transactions Transaction[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([merchantId])
  @@index([paymentIntentId])
  @@index([invoiceId])
  @@index([txHash])
  @@index([reference])
  @@index([status])
  @@index([merchantId, status])
  @@index([merchantId, createdAt])
}

model Transaction {
  id String @id @default(uuid())

  paymentId String

  payment Payment @relation(fields: [paymentId], references: [id])

  txHash String @unique

  fromAddress String

  toAddress String

  network ChainNetwork

  tokenAddress String

  amount Decimal @db.Decimal(20, 6)

  gasFee Decimal? @db.Decimal(20, 6)

  gasUsed BigInt?

  confirmations Int @default(0)

  type TransactionType

  status TransactionStatus @default(PENDING)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([txHash])
  @@index([status])
}

model ApiKey {
  id String @id @default(uuid())

  merchantId String

  merchant Merchant @relation(fields: [merchantId], references: [id])

  name String

  keyId String @unique

  secretHash String

  status ApiKeyStatus @default(ACTIVE)

  lastUsedAt DateTime?

  expiresAt DateTime?

  userId String?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Session {
  id String @id @default(uuid())

  token String @unique

  userId String

  user User @relation(fields: [userId], references: [id])

  expiresAt DateTime

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id])

  action String

  resource String

  metadata Json?

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())
}

model Webhook {
  id String @id @default(uuid())

  merchantId String

  merchant Merchant @relation(fields: [merchantId], references: [id])

  url String

  secretHash String

  enabled Boolean @default(true)

  failureCount Int @default(0)

  lastTriggeredAt DateTime?

  lastError String?

  eventFilter Json?

  createdAt DateTime @default(now())
}

model WebhookEvent {
  id String @id @default(uuid())

  merchantId String

  merchant Merchant @relation(fields: [merchantId], references: [id])

  event String

  payload Json

  response Json?

  delivered Boolean @default(false)

  deliveredAt DateTime?

  attempt Int @default(0)

  createdAt DateTime @default(now())

  @@index([merchantId])
  @@index([event])
  @@index([delivered])
}


model PaymentLink {
  id          String   @id @default(cuid())

  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  title       String
  description String?

  amount      Decimal   @db.Decimal(18,6)

  currency    String     @default("USDC")

  recipient   String

  status      PaymentLinkStatus @default(ACTIVE)

  expiresAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
  @@index([recipient])
  @@index([status])
}