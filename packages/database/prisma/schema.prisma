generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MerchantStatus {
  ACTIVE
  DISABLED
}

enum InvoiceStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id          String      @id @default(cuid())

  wallet      String      @unique
  email       String?     @unique
  username    String?
  avatar      String?

  merchants   Merchant[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Merchant {

  id          String      @id @default(cuid())

  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id])

  name        String
  slug        String      @unique

  logo        String?

  status      MerchantStatus @default(ACTIVE)

  invoices    Invoice[]

  apiKeys     ApiKey[]

  webhooks    Webhook[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invoice {

  id          String      @id @default(cuid())

  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id])

  amount      Decimal

  currency    String      @default("USDC")

  memo        String?

  status      InvoiceStatus @default(PENDING)

  expiresAt   DateTime?

  paidAt      DateTime?

  payment     Payment?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {

  id          String      @id @default(cuid())

  invoiceId   String      @unique

  invoice     Invoice @relation(fields: [invoiceId], references: [id])

  payer       String

  txHash      String      @unique

  network     String

  token       String

  amount      Decimal

  status      PaymentStatus @default(PENDING)

  createdAt   DateTime @default(now())
}

model ApiKey {

  id          String      @id @default(cuid())

  merchantId  String

  merchant    Merchant @relation(fields: [merchantId], references: [id])

  name        String

  secret      String      @unique

  createdAt   DateTime @default(now())
}

model Webhook {

  id          String      @id @default(cuid())

  merchantId  String

  merchant    Merchant @relation(fields: [merchantId], references: [id])

  url         String

  secret      String

  enabled     Boolean @default(true)

  createdAt   DateTime @default(now())
}